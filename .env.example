# -----------------------------------------------------------------------------
# Portfolio Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: Never store confidential secrets, emails, social links, or CV paths in .env.
# -----------------------------------------------------------------------------

# Public production URL of the portfolio (used for canonical, Open Graph, and Twitter metadata).
# When deploying (e.g. Netlify), configure this in the site settings / environment variables dashboard.
# Example: https://your-portfolio.netlify.app
VITE_SITE_URL=https://example.com

# Model encryption password (Node.js build scripts only, read by scripts/encrypt.cjs).
# NOTE: No VITE_ prefix. Never imported in client-side code (src/).
MODEL_PASSWORD=change-me
